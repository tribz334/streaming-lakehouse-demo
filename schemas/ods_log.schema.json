{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ustc.example/schema/ods_log.schema.json",
  "title": "ODS Shared Tracking Log Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["log_type", "event_id", "ts", "user_id", "event_type", "schema_version"],
  "properties": {
    "log_type": { "type": "string", "enum": ["ad", "page"] },
    "event_id": { "type": "string" },
    "ts": { "type": "string", "format": "date-time" },
    "user_id": { "type": "string" },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "product_id": { "type": "string" },
    "pid": {
      "type": "string",
      "description": "Advertising slot id observed by the client; it is not an ad unit id."
    },
    "creative_id": { "type": "string" },
    "media": { "type": "string" },
    "commerce_scene": {
      "type": "string",
      "enum": ["live", "short_video", "shop", "external"]
    },
    "traffic_type": { "type": "string", "enum": ["paid", "organic"] },
    "region": { "type": "string" },
    "page_id": { "type": "string" },
    "last_page_id": { "type": ["string", "null"] },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "device_id": { "type": "string" },
    "source": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "log_type": { "const": "ad" } } },
      "then": {
        "properties": {
          "event_type": { "enum": ["impression", "click", "conversion"] }
        },
        "required": [
          "product_id", "pid", "creative_id", "media",
          "commerce_scene", "traffic_type", "region"
        ]
      }
    },
    {
      "if": { "properties": { "log_type": { "const": "page" } } },
      "then": {
        "required": ["page_id", "duration_ms", "device_id", "source"]
      }
    }
  ]
}
