{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ustc.example/schema/ods_log.schema.json",
  "title": "ODS Raw SDK Tracking Report",
  "description": "Raw client message retained before DWD action flattening.",
  "type": "object",
  "additionalProperties": false,
  "required": ["bus_id", "app_id", "log_id", "msg_id", "common", "actions", "ts"],
  "properties": {
    "bus_id": { "type": "integer", "description": "Business-line id." },
    "app_id": { "type": "integer", "description": "Client/application id." },
    "log_id": { "type": "integer", "description": "Tracking definition id assigned by the tracking platform." },
    "msg_id": { "type": "integer", "description": "Unique BIGINT id of one SDK message." },
    "common": {
      "type": "object",
      "additionalProperties": false,
      "required": ["area", "ip", "uid", "device_id", "platform", "app_version", "browser_version", "sdk_version"],
      "properties": {
        "uid": { "type": "integer" },
        "area": { "type": "string" },
        "ip": { "type": "string" },
        "device_id": { "type": "integer" },
        "platform": { "type": "integer", "enum": [0, 1] },
        "app_version": { "type": "string" },
        "browser_version": { "type": "string" },
        "sdk_version": { "type": "string" }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "action", "creative_id", "product_id", "slot_id", "media", "commerce_scene", "traffic_type", "play_during", "ts"],
        "properties": {
          "event_id": { "type": "integer" },
          "action": { "type": "string", "enum": ["delivery", "impression", "click", "conversion"] },
          "creative_id": { "type": "integer" },
          "product_id": { "type": "integer" },
          "slot_id": { "type": "integer", "description": "Client-observed advertising slot id." },
          "media": { "type": "string" },
          "commerce_scene": { "type": "string" },
          "traffic_type": { "type": "string" },
          "play_during": { "type": "integer", "minimum": 0 },
          "ts": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "ts": { "type": "integer", "minimum": 0, "description": "SDK report time in epoch milliseconds." }
  }
}
