{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ustc.example/schema/ods_log_di.schema.json",
  "title": "ODS Raw SDK Tracking Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["bus_id", "app_id", "log_id", "msg_id", "common", "events", "ts"],
  "properties": {
    "bus_id": {
      "type": "integer"
    },
    "app_id": {
      "type": "integer"
    },
    "log_id": {
      "type": "integer"
    },
    "msg_id": {
      "type": "integer"
    },
    "common": {
      "type": "object",
      "additionalProperties": false,
      "required": ["area", "ip", "uid", "device_id", "platform", "app_version", "browser_version", "sdk_version"],
      "properties": {
        "uid": {
          "type": "integer"
        },
        "area": {
          "type": "string"
        },
        "ip": {
          "type": "string"
        },
        "device_id": {
          "type": "integer"
        },
        "platform": {
          "type": "integer",
          "enum": [0, 1]
        },
        "app_version": {
          "type": "string"
        },
        "browser_version": {
          "type": "string"
        },
        "sdk_version": {
          "type": "string"
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event",
          "creative_id",
          "product_id",
          "slot_id",
          "scene",
          "ts"
        ],
        "properties": {
          "event": {
            "type": "string",
            "enum": ["delivery", "impression", "click", "conversion"]
          },
          "creative_id": {
            "type": "integer"
          },
          "product_id": {
            "type": "integer"
          },
          "slot_id": {
            "type": "integer"
          },
          "scene": {
            "type": "string",
            "enum": ["ecommerce", "short_video", "live"],
            "description": "广告场景：电商、短视频或直播"
          },
          "ts": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "ts": {
      "type": "integer",
      "minimum": 0
    }
  }
}
